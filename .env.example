DB_NAME=erp_escola
DB_USER=erp_user
DB_PASSWORD=coloque_sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432
SECRET_KEY=troque_por_uma_chave_gerada_com_get_random_secret_key
#comando pra gerar a chave no terminal: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
FIELD_ENCRYPTION_KEYS=troque_por_chave_gerada_com_Fernet.generate_key
# comando pra gerar a chave no terminal: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BLIND_INDEX_KEY=troque_por_chave_aleatoria_com_pelo_menos_32_caracteres
# comando pra gerar a chave no terminal: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Configurações de e-mail (SMTP)
# Opções: django.core.mail.backends.console.EmailBackend (dev)
#         django.core.mail.backends.smtp.EmailBackend (produção)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servidor SMTP (exemplos: smtp.gmail.com, smtp.sendgrid.net, smtp.resend.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciais do servidor SMTP
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_aplicativo_aqui

# E-mail que aparecerá como remetente
EMAIL_FROM=noreply@escolaprofissionalizante.com.br